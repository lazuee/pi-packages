{
  "private": true,
  "name": "@gotgenes/pi-packages",
  "type": "module",
  "description": "Monorepo for @gotgenes pi packages",
  "packageManager": "pnpm@11.25.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "prepare": "command -v prek >/dev/null 2>&1 && prek install || echo 'prek not found \u2014 skipping hook install (see README)'",
    "check": "pnpm -r run check",
    "test": "pnpm -r run test && vitest run",
    "test:scripts": "vitest run",
    "lint": "biome check . && eslint packages/ && rumdl check . && node scripts/lint/invisible-characters.mjs && node scripts/lint/unicode-escapes.mjs",
    "lint:fix": "biome check --write . && eslint packages/ --fix && rumdl fmt . && node scripts/lint/invisible-characters.mjs --fix && node scripts/lint/unicode-escapes.mjs --fix",
    "format": "biome format --write .",
    "fallow": "fallow",
    "fallow:audit": "fallow audit",
    "fallow:health": "fallow health --score --hotspots --targets",
    "fallow:dead-code": "fallow dead-code",
    "fallow:dupes": "fallow dupes"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.11",
    "@vitest/coverage-istanbul": "^4.1.11",
    "eslint": "^10.9.1",
    "fallow": "^3.22.0",
    "globals": "^17.12.0",
    "rumdl": "0.2.24",
    "typescript-eslint": "^8.69.0",
    "vitest": "^4.1.11"
  },
  "keywords": [
    "pi-package"
  ],
  "license": "MIT",
  "pi": {
    "extensions": [
      "packages/pi-agent-desktop/src/extension.ts",
      "packages/pi-autoformat/src/extension.ts",
      "packages/pi-colgrep/src/extension.ts",
      "packages/pi-github-tools/src/extension.ts",
      "packages/pi-nocd/src/index.ts",
      "packages/pi-permission-model-judge/src/index.ts",
      "packages/pi-permission-system/src/index.ts",
      "packages/pi-session-tools/src/index.ts",
      "packages/pi-subagents/src/index.ts",
      "packages/pi-subagents-worktrees/src/index.ts",
      "packages/pi-macos-harness/src/extension.ts"
    ],
    "skills": [
      "packages/pi-colgrep/skills",
      "packages/pi-macos-harness/skills",
      "packages/pi-agent-desktop/skills"
    ]
  },
  "dependencies": {
    "@gotgenes/pi-permission-system": "workspace:^",
    "@gotgenes/pi-subagents": "workspace:^",
    "@gotgenes/pi-subagents-worktrees": "workspace:^",
    "tree-sitter-bash": "^0.25.1",
    "web-tree-sitter": "^0.26.9",
    "zod": "^4.6.7"
  }
}
