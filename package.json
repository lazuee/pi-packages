{
	"name": "pi-packages",
	"private": true,
	"type": "module",
	"workspaces": [
		"packages/*"
	],
	"scripts": {
		"check": "bun run --filter '*' check",
		"build": "bun run --filter '*' build",
		"fmt": "prettier --write .",
		"fmt:check": "prettier --check .",
		"prepack": "bun run check && bun run build"
	},
	"devDependencies": {
		"@earendil-works/pi-coding-agent": "1.5.2",
		"@types/bun": "latest",
		"@typescript/native-preview": "^7.0.0-dev.20260707.2",
		"prettier": "3.6.2",
		"typebox": "1.3.27",
		"typescript": "5.9.3"
	},
	"pi": {
		"extensions": [
			"./packages/pi-extensions/index.ts"
		],
		"skills": [
			"./packages/pi-skill-agent-harness/skills"
		]
	}
}
