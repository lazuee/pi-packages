{
  "name": "@lazuee/pi-auto-trees",
  "version": "0.0.1",
  "description": "A Pi package that adds /marker and /end commands for incremental long-running coding sessions.",
  "keywords": [
    "coding-agent",
    "pi-coding-agent",
    "pi-extension",
    "pi-package",
    "session-management",
    "slash-command"
  ],
  "homepage": "https://github.com/lazuee/pi-packages/tree/main/packages/pi-auto-trees#readme",
  "bugs": {
    "url": "https://github.com/lazuee/pi-packages/issues"
  },
  "license": "MIT",
  "author": "lazuee",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lazuee/pi-packages.git",
    "directory": "packages/pi-auto-trees"
  },
  "files": [
    "index.ts",
    "src",
    "README.md",
    "LICENSE",
    "tsconfig.json",
    "CHANGELOG.md"
  ],
  "type": "module",
  "main": "index.ts",
  "exports": "./index.ts",
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "check": "tsgo --noEmit",
    "pack:dry": "npm pack --dry-run",
    "prepublishOnly": "bun run check && bun run pack:dry"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "1.6.0",
    "@howaboua/pi-codex-conversion": "5.0.1",
    "typescript": "^7.0.2"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": ">=1.5.0",
    "@earendil-works/pi-tui": ">=1.0.0",
    "@howaboua/pi-codex-conversion": ">=5.0.1"
  },
  "peerDependenciesMeta": {
    "@howaboua/pi-codex-conversion": {
      "optional": true
    }
  },
  "overrides": {
    "uuid": "14.0.0"
  },
  "engines": {
    "node": ">=20.6.0"
  },
  "pi": {
    "extensions": [
      "./index.ts"
    ]
  }
}
