{
  "name": "@lazuee/pi-github-watch",
  "version": "0.0.1",
  "description": "Opt-in same-session GitHub comment and Actions run watches for Pi",
  "keywords": [
    "github",
    "pi-extension",
    "pi-package"
  ],
  "license": "MIT",
  "author": "lazuee",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lazuee/pi-packages.git",
    "directory": "packages/pi-github-watch"
  },
  "files": [
    "index.ts",
    "src",
    "README.md",
    "LICENSE",
    "tsconfig.json",
    "CHANGELOG.md"
  ],
  "type": "module",
  "main": "index.ts",
  "exports": "./index.ts",
  "scripts": {
    "check": "tsgo --noEmit",
    "pack:dry": "npm pack --dry-run"
  },
  "dependencies": {
    "@earendil-works/pi-schema": "1.6.0"
  },
  "devDependencies": {
    "@earendil-works/pi-ai": "1.6.0",
