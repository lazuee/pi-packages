    "url": "https://github.com/lazuee/pi-packages/issues"
  },
  "license": "MIT",
  "author": "lazuee",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lazuee/pi-packages.git",
    "directory": "packages/pi-shepherdr"
  },
  "files": [
    "index.ts",
    "worker-api.ts",
    "src",
    "profiles",
    "README.md",
    "LICENSE",
    "tsconfig.json",
    "CHANGELOG.md"
  ],
  "type": "module",
  "main": "index.ts",
  "exports": {
    ".": "./index.ts",
    "./worker-api": "./worker-api.ts"
  },
  "publishConfig": {
