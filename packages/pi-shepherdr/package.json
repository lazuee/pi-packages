{
  "name": "@lazuee/pi-shepherdr",
  "version": "0.0.1",
  "description": "Persistent blocking and asynchronous Pi agents through Herdr.",
  "keywords": [
    "agents",
    "herdr",
    "orchestration",
    "pi",
    "pi-extension",
    "pi-package",
    "shepherdr"
  ],
  "homepage": "https://github.com/lazuee/pi-packages/tree/main/packages/pi-shepherdr#readme",
