{
  "name": "@lazuee/pi-ask",
  "version": "0.1.0",
  "description": "Pi extension giving the agent an interactive ask_user clarification tool, with a form, background questions, and child-agent forwarding",
  "keywords": [
    "pi-package",
    "pi",
    "pi-extension",
    "ask_user",
    "clarification",
    "human-in-the-loop",
    "terminal-ui"
  ],
  "author": {
    "name": "lazuee",
    "url": "https://github.com/lazuee"
  },
  "contributors": [
    {
      "name": "Chris Lasher",
      "url": "https://github.com/gotgenes"
    }
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lazuee/pi-packages.git",
    "directory": "packages/pi-ask"
  },
  "bugs": {
    "url": "https://github.com/lazuee/pi-packages/issues"
  },
  "homepage": "https://github.com/lazuee/pi-packages/tree/main/packages/pi-ask#readme",
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=22"
  },
  "type": "module",
  "imports": {
    "#src/*": "./src/*"
  },
  "files": [
    "src",
    "docs/*.md",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "pi": {
    "extensions": [
      "./src/index.ts"
    ]
  },
  "scripts": {
    "check": "tsc --noEmit",
    "format": "biome format --write",
    "lint": "biome check . && eslint .",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "devDependencies": {
    "@biomejs/biome": "catalog:",
    "@earendil-works/pi-ai": "catalog:",
    "@earendil-works/pi-coding-agent": "catalog:",
    "@earendil-works/pi-tui": "catalog:",
    "@lydell/node-pty": "1.2.0-beta.18",
    "@types/node": "catalog:",
    "pi-coding-agent-test": "0.1.6",
    "typebox": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": "catalog:",
    "@earendil-works/pi-coding-agent": "catalog:",
    "@earendil-works/pi-tui": "catalog:",
    "typebox": "catalog:"
  },
  "peerDependenciesMeta": {
    "@earendil-works/pi-ai": {
      "optional": true
    },
    "@earendil-works/pi-tui": {
      "optional": true
    }
  }
}
