{
  "name": "@lazuee/pi-agent-comms",
  "version": "0.0.1",
  "description": "Session notes, context continuity and agent message boards for Pi",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lazuee/pi-packages.git",
    "directory": "packages/pi-agent-comms"
  },
  "files": [
    "index.ts",
    "src",
    "dist",
    "docs",
    "README.md",
    "INTEGRATION.md",
    "PCC-INTEGRATION.md",
    "LICENSE",
    "tsconfig.json",
    "CHANGELOG.md"
  ],
  "type": "module",
  "main": "index.ts",
  "exports": {
    ".": "./index.ts",
    "./context-sharing": "./src/notes/context-sharing.ts",
    "./saved-session": "./src/notes/saved-session.mjs",
    "./saved-session-index": "./src/notes/saved-session-index.mjs",
    "./runtime": "./src/board/runtime/index.ts",
    "./integration": "./src/board/integration.ts"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "node scripts/build-viewer.mjs",
    "check": "tsgo --noEmit && bun test",
    "pack:dry": "npm pack --dry-run",
    "prepack": "bun run build"
  },
  "dependencies": {
    "@earendil-works/pi-schema": "1.5.2",
    "better-sqlite3": "13.0.3",
    "dompurify": "3.4.17",
    "marked": "18.2.0",
    "unicode-case-folding": "1.1.2"
  },
  "devDependencies": {
    "@howaboua/pi-codex-conversion": "5.0.1",
    "@types/better-sqlite3": "9.6.0",
    "typescript": "^7.0.2"
  },
  "peerDependencies": {
    "@earendil-works/pi-agent-core": ">=1.0.4",
    "@earendil-works/pi-ai": ">=1.1.0",
    "@earendil-works/pi-coding-agent": ">=1.5.0",
    "@earendil-works/pi-tui": ">=1.1.0",
    "@howaboua/pi-codex-conversion": ">=5.0.1"
  },
  "peerDependenciesMeta": {
    "@howaboua/pi-codex-conversion": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "pi": {
    "extensions": [
      "./index.ts"
    ]
  }
}
