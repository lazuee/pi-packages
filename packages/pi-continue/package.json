{
  "name": "@lazuee/pi-continue",
  "version": "0.1.0",
  "description": "Pi extension that detects a stalled agent run at the settle boundary and nudges it back into motion, bounded by brakes and a per-session gateway",
  "imports": {
    "#src/*": "./src/*",
    "#test/*": "./test/*"
  },
  "keywords": [
    "pi-package",
    "pi-extension",
    "pi-coding-agent",
    "auto-continue",
    "stall-recovery",
    "resilience"
  ],
  "author": {
    "name": "lazuee",
    "url": "https://github.com/lazuee"
  },
  "contributors": [
    {
      "name": "Chris Lasher",
      "url": "https://github.com/gotgenes"
    }
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lazuee/pi-packages.git",
    "directory": "packages/pi-continue"
  },
  "bugs": {
    "url": "https://github.com/lazuee/pi-packages/issues"
  },
  "homepage": "https://github.com/lazuee/pi-packages/tree/main/packages/pi-continue#readme",
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=22"
  },
  "type": "module",
  "files": [
    "src",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "pi": {
    "extensions": [
      "./src/extension.ts"
    ]
  },
  "scripts": {
    "check": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint:md": "rumdl check *.md docs/**/*.md",
    "lint": "biome check . && eslint . && pnpm run lint:md"
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": "catalog:",
    "@earendil-works/pi-coding-agent": "catalog:",
    "typebox": "catalog:"
  },
  "devDependencies": {
    "@biomejs/biome": "catalog:",
    "@earendil-works/pi-coding-agent": "catalog:",
    "@types/node": "catalog:",
    "rumdl": "catalog:",
    "typebox": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
